# Soca Manager — passwordless database service management
# systemctl start/stop
ALL ALL=(root) NOPASSWD: /usr/bin/systemctl start mysql, /usr/bin/systemctl stop mysql, /usr/bin/systemctl start mysqld, /usr/bin/systemctl stop mysqld, /usr/bin/systemctl start mariadb, /usr/bin/systemctl stop mariadb, /usr/bin/systemctl start postgresql, /usr/bin/systemctl stop postgresql, /usr/bin/systemctl start mongod, /usr/bin/systemctl stop mongod, /usr/bin/systemctl start mysql.service, /usr/bin/systemctl stop mysql.service, /usr/bin/systemctl start mysqld.service, /usr/bin/systemctl stop mysqld.service, /usr/bin/systemctl start mariadb.service, /usr/bin/systemctl stop mariadb.service, /usr/bin/systemctl start postgresql.service, /usr/bin/systemctl stop postgresql.service, /usr/bin/systemctl start mongod.service, /usr/bin/systemctl stop mongod.service
# apt-get install/remove
ALL ALL=(root) NOPASSWD: /usr/bin/apt-get install -y mysql-server, /usr/bin/apt-get remove -y mysql-server, /usr/bin/apt-get install -y postgresql, /usr/bin/apt-get remove -y postgresql, /usr/bin/apt-get install -y mongodb-org, /usr/bin/apt-get remove -y mongodb-org, /usr/bin/apt-get update
# dnf install/remove
ALL ALL=(root) NOPASSWD: /usr/bin/dnf install -y mysql-server, /usr/bin/dnf remove -y mysql-server, /usr/bin/dnf install -y postgresql-server, /usr/bin/dnf remove -y postgresql-server, /usr/bin/dnf install -y mongodb-org, /usr/bin/dnf remove -y mongodb-org
